PORT=3000
# Free key from https://console.groq.com  : required unless HF_TOKEN is set
GROQ_API_KEY=
# Any open-weight model id available on Groq (free tier: openai/gpt-oss-120b, openai/gpt-oss-20b, qwen/qwen3.8-27b)
GROQ_MODEL=openai/gpt-oss-120b
# Free token from https://huggingface.co  : optional, enables the Gemma provider
HF_TOKEN=
HF_MODEL=google/gemma-2-9b-it
